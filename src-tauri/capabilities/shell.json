{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Trusted browser UI only (each browser window's shell + overlay webviews). Web content tabs are raw WebView2 controllers with no Tauri IPC and are never listed here.",
  "local": true,
  "windows": [],
  "webviews": [
    "shell-*",
    "overlay-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-browser-snapshot",
    "allow-tab-create",
    "allow-tab-close",
    "allow-tab-activate",
    "allow-tab-move",
    "allow-tab-tear-off",
    "allow-tab-drag-start",
    "allow-tab-drop",
    "allow-tab-reopen-closed",
    "allow-tab-context-menu",
    "allow-nav-go",
    "allow-nav-back",
    "allow-nav-forward",
    "allow-nav-reload",
    "allow-nav-stop",
    "allow-zoom-change",
    "allow-find-in-page",
    "allow-find-stop",
    "allow-print-page",
    "allow-focus-content",
    "allow-https-continue",
    "allow-layout-update",
    "allow-overlay-show",
    "allow-overlay-hide",
    "allow-menu-open-main",
    "allow-suggest",
    "allow-top-sites",
    "allow-bookmarks-list",
    "allow-bookmark-toggle",
    "allow-bookmark-remove",
    "allow-bookmark-update",
    "allow-history-list",
    "allow-history-delete",
    "allow-downloads-list",
    "allow-download-cancel",
    "allow-download-resume",
    "allow-download-open",
    "allow-download-show",
    "allow-download-remove",
    "allow-downloads-clear",
    "allow-settings-get",
    "allow-settings-update",
    "allow-protection-status",
    "allow-adblock-set-enabled",
    "allow-adblock-set-site-enabled",
    "allow-site-exceptions-list",
    "allow-filter-lists",
    "allow-filter-list-add",
    "allow-filter-list-remove",
    "allow-filter-list-set-enabled",
    "allow-filter-lists-update",
    "allow-custom-rules-get",
    "allow-custom-rules-set",
    "allow-clear-browsing-data",
    "allow-permissions-list",
    "allow-permission-set",
    "allow-permission-respond",
    "allow-external-protocol-respond",
    "allow-app-info",
    "allow-bookmark-create-folder",
    "allow-bookmark-move",
    "allow-bookmark-import-sources",
    "allow-bookmark-import-browser",
    "allow-bookmark-import-file",
    "allow-bookmark-folder-menu",
    "allow-bookmark-item-menu",
    "allow-tab-group-menu",
    "allow-tab-group-update",
    "allow-split-set",
    "allow-split-close",
    "allow-window-new",
    "allow-bookmark-add",
    "allow-bookmark-bar-menu",
    "allow-passwords-list",
    "allow-passwords-for-tab",
    "allow-password-fill",
    "allow-password-reveal",
    "allow-password-update",
    "allow-password-delete",
    "allow-passwords-never-list",
    "allow-passwords-never-remove"
  ]
}
